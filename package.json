{
  "name": "sunmark-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sunmark — a mobile-first Persian-language strategy board game built with Phaser 4 and TypeScript.",
  "scripts": {
    "assets:optimize": "python3 scripts/optimize-images.py",
    "assets:check": "python3 scripts/optimize-images.py --check",
    "assets:anahita": "python3 scripts/optimize-anahita.py",
    "assets:anahita:check": "python3 scripts/optimize-anahita.py --check",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pwa:check": "node scripts/check-pwa.mjs",
    "pwa:icons": "python3 scripts/export-pwa-icons.py",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run api:check && npm run lint && npm run format:check && npm test && npm run build && npm run pwa:check",
    "test:api": "vitest run --config vitest.config.integration.ts",
    "api:generate": "openapi-typescript contracts/openapi.json -o src/online/shared/http.d.ts",
    "api:sync": "node scripts/api-sync.mjs",
    "api:check": "node scripts/api-check.mjs"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "socket.io-client": "4.8.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "openapi-typescript": "7.10.1",
    "prettier": "3.9.10",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.71.2",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "homepage": "https://sunmarkgame.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedaravane/sunmark-web.git"
  },
  "bugs": {
    "url": "https://github.com/hamedaravane/sunmark-web/issues"
  }
}
