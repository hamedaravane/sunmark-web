  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": { "headless": true, "args": ["--no-sandbox", "--disable-dev-shm-usage"] },
    "contextOptions": { "viewport": { "width": 390, "height": 844 }, "deviceScaleFactor": 1 }
  },
  "outputDir": "output/playwright"
}
