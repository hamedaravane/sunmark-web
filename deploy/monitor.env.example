# /etc/sunmark/monitor.env, root:root 0600.
# HTTPS receiver accepting JSON {"text":"..."}; keep tokens in this protected URL.
# For Telegram, use a compatible receiver/relay; this is not a Telegram bot API payload.
ALERT_WEBHOOK_URL=https://your-alert-receiver.example/sunmark
# An external dead-man check: GET this private HTTPS URL after a healthy check.
# Configure its expected interval to 1 minute and grace to at least 5 minutes.
# This external service is what detects loss of the entire VM/network/monitor.
HEARTBEAT_URL=https://your-heartbeat-provider.example/private-check-url
