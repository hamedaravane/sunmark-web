# Install as /etc/sunmark/deploy.env, owned by root with mode 0600.
# This file uses simple shell-compatible KEY=value assignments (quote spaces).
DOMAIN=play.your-domain.example
ACME_EMAIL=admin@your-domain.example
SUNMARK_CONFIG_DIR=/etc/sunmark
SUNMARK_STATE_DIR=/var/lib/sunmark
SUNMARK_INSTALL_DIR=/opt/sunmark
COMPOSE_PROJECT_NAME=sunmark-production
# Off-server encrypted Restic repository, e.g. your S3-compatible storage.
RESTIC_REPOSITORY=s3:https://s3.your-provider.example/sunmark-backups
RESTIC_PASSWORD_FILE=/etc/sunmark/secrets/restic-password
# Monitoring (percent; backup freshness in hours; certificate expiry in days).
DISK_WARN_PERCENT=85
MEMORY_WARN_PERCENT=90
CPU_WARN_LOAD_PER_CORE=2
BACKUP_MAX_AGE_HOURS=26
TLS_WARN_DAYS=14
ALERT_REPEAT_SECONDS=3600
